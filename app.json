{
  "expo": {
    "name": "CPR",
    "slug": "cpr-canadian-psychological-resources",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-qpr.png",
    "scheme": "cpresources",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-icon-qpr.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.cpresources.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserNotificationsUsageDescription": "CPR uses notifications to keep you updated on your bookings and messages from therapists."
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.ca.cpresources.app.onesignal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-qpr.png",
        "backgroundColor": "#000000"
      },
      "package": "ca.cpresources.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/app-icon-qdw.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://77zgefkppvrujkkwanvht7mztqqrxrhy.app.specular.dev",
      "revenueCatTestApiKeyIos": "test_mgGOuFmGXvDNFxsHGsqwWNJmOrm",
      "revenueCatTestApiKeyAndroid": "test_mgGOuFmGXvDNFxsHGsqwWNJmOrm",
      "revenueCatEntitlementId": "featured",
